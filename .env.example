# Copy to .env and fill in real values. Never commit .env.

# --- Postgres (infra/docker-compose.yml) ---
POSTGRES_USER=mgpa
POSTGRES_PASSWORD=change-me
POSTGRES_DB=mgpa
POSTGRES_PORT=5432

# Connection string used by backend, workflows and pipelines (psycopg 3 driver)
DATABASE_URL=postgresql+psycopg://mgpa:change-me@localhost:5432/mgpa

# --- Claude (Anthropic API) — costs arise per token, see console.anthropic.com ---
# Secret. Create at console.anthropic.com -> API Keys. Never commit the real value.
ANTHROPIC_API_KEY=sk-ant-...
# Model used by the chat agent. Cheapest current option: claude-haiku-5-5;
# higher quality: claude-sonnet-5-5 or claude-opus-5-5 (see docs/ARCHITECTURE.md, costs).
ANTHROPIC_MODEL=claude-haiku-5-5
# Thinking depth: low | medium | high | xhigh | max (higher = slower and more tokens)
ANTHROPIC_EFFORT=low

# --- Chat context management (optional, defaults shown) ---
# Fold older messages into a summary once one turn's input exceeds this many tokens.
SUMMARY_TRIGGER_TOKENS=8000
# Most recent messages that always stay word for word.
SUMMARY_KEEP_MESSAGES=6

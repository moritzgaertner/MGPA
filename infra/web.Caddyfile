# Inner web server of MGPA (inside its own container, plain HTTP on :80).
# HTTPS is done by the server's shared Caddy in front of it, which routes by hostname.
{
	admin off
	auto_https off
	servers {
		# Requests come through the shared Caddy: trust its X-Forwarded-* headers.
		trusted_proxies static private_ranges
	}
}

:80 {
	encode zstd gzip

	# API: strip the /api prefix and forward to FastAPI (SSE streams are flushed as they come).
	handle_path /api/* {
		reverse_proxy backend:8000
	}

	handle {
		root * /srv
		# Hashed build assets never change -> cache for a year; index.html is always revalidated.
		header /assets/* Cache-Control "public, max-age=31536000, immutable"
		header / Cache-Control "no-cache"
		# Client-side routes (/training, /chat/12) all load index.html.
		try_files {path} /index.html
		file_server
	}
}
